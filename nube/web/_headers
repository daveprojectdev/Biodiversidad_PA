# Cabeceras de los archivos estáticos (las rutas de la API las pone Hono).
/*
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; style-src 'self'; font-src 'self'; script-src 'self' https://static.cloudflareinsights.com; img-src 'self' data: https://inaturalist-open-data.s3.amazonaws.com https://static.inaturalist.org; media-src blob: https://inaturalist-open-data.s3.amazonaws.com https://static.inaturalist.org; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
