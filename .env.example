# ============================================================
# .env.example — copiar a .env y llenar con tus valores reales
# NUNCA subir el .env real a GitHub (ya está en .gitignore)
# ============================================================

# MySQL — usuario dedicado, NO root
DB_HOST=localhost
DB_PORT=3306
DB_USER=biodiv_app
DB_PASS=cambia_esta_contrasena

# Cascada LLM — cuál probar primero (ollama | groq | gemini)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:1.7b
GROQ_API_KEY=gsk_tu_key_aqui
GEMINI_API_KEY=AIza_tu_key_aqui

# Voz
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8
TTS_VOICE=es-PA-RobertoNeural

# Acceso demo (token simple para cuando uses ngrok con Vejarano)
DEMO_TOKEN=elige_un_token_largo_y_aleatorio

# Servidor
PORT=5000
